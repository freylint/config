// Features:
// - Strict type-checking with no emit (tsc used for validation only)
// - ESNext/bundler module resolution for esbuild compatibility
// - isolatedModules for safe esbuild+tsc split compilation
// - Node.js types included for serve.ts (node:fs, node:http, __dirname, process, etc.)
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["node"],
    "lib": ["ES2020", "DOM"]
  },
  "include": ["src/**/*.ts"]
}
